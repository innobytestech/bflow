{
  "permissions": {
    "allow": ["Bash(bflow *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "bflow hook session-start", "timeout": 30 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [{ "type": "command", "command": "bflow guard --reads", "timeout": 10 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bflow hook tokens", "timeout": 20 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "bflow hook tokens", "timeout": 20 }] },
      {
        "matcher": "bflow-.*",
        "hooks": [{ "type": "command", "command": "bflow hook subagent-stop", "timeout": 20 }]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "bflow statusline" }
}
